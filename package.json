    "express-session": "^1.17.3",
    "puppeteer": "^24.43.1",
    "session-file-store": "^1.5.0",
    "sharp": "^0.34.5",
    "stack": "^0.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
