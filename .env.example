# ================================================
# CONFIGURACIÓN LOCAL - Variables de Entorno
# ================================================

# Puerto del servidor
PORT=3000

# URLs de API y aplicación (para desarrollo local)
API_BASE_URL=/api
APP_BASE_URL=
PUBLIC_BASE_URL=http://localhost:3000

# Secreto de sesión (cambiar en producción)
SESSION_SECRET=taller-tech-secret

# Orígenes permitidos para CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Node environment
NODE_ENV=development

# Logs
LOG_LEVEL=debug

